# apps/web — client-safe values only.
#
# Every variable here is compiled into the browser bundle. Nothing secret may
# appear in this file or in a real .env. See docs/SECRETS.md; CI enforces it via
# scripts/scan-secrets.mjs.

# Supabase project URL for this environment.
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Anon key. Safe in a bundle only because Module 3 locks the rows with RLS.
VITE_SUPABASE_ANON_KEY=replace-with-the-anon-key-for-this-environment

# Payment gateway PUBLIC key id. Never the key secret.
VITE_PAYMENT_GATEWAY_KEY_ID=

# local | staging | production
VITE_APP_ENV=local
