{
  "name": "@rural-opd/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "start:web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "echo \"@rural-opd/mobile has no tests until Module 6\"",
    "build": "expo export --platform android --output-dir dist --clear"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.12",
    "@rural-opd/shared": "workspace:*",
    "@rural-opd/tokens": "workspace:*",
    "@supabase/supabase-js": "^2.112.3",
    "expo": "~57.0.15",
    "expo-constants": "~57.0.0",
    "expo-linking": "~57.0.0",
    "expo-router": "~57.0.15",
    "expo-status-bar": "~57.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@rural-opd/config": "workspace:*",
    "@types/react": "^19.2.18",
    "eslint": "^9.39.5",
    "typescript": "5.9.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
