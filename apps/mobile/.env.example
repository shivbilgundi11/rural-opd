# apps/mobile — client-safe values only.
#
# EXPO_PUBLIC_* variables are inlined into the JavaScript bundle and shipped to
# every device. Treat this file as public. See docs/SECRETS.md; CI enforces it
# via scripts/scan-secrets.mjs.
#
# On a physical device the local Supabase stack is NOT reachable at 127.0.0.1 —
# use your machine's LAN address (e.g. http://192.168.1.20:54321).

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-the-anon-key-for-this-environment

# Payment gateway PUBLIC key id. Never the key secret.
EXPO_PUBLIC_PAYMENT_GATEWAY_KEY_ID=

# local | staging | production
EXPO_PUBLIC_APP_ENV=local
